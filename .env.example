# Copy to .env and fill in. Leave both credentials empty to use the local demo.

# The map needs no key (MapLibre + OpenFreeMap + deck.gl).

# Nexconn Chat App Key (console.nexconn.ai -> App Key page). Sent to the browser.
NEXCONN_APP_KEY=
# Nexconn App Secret. Server only (token + room endpoints). Never sent to the browser.
# Enable open channels and open-channel metadata for hosted pins and RSVPs.
# Enable open-channel cloud retention for history and media storage for photo uploads.
# Restart the app server after changing credentials. Both dev and preview serve the token API.
NEXCONN_APP_SECRET=
# Platform API host for your app's data center (default Singapore).
NEXCONN_API_HOST=api.sg-light-api.com

# "Ask about my neighbourhood": Claude writes the answers when this key is set.
# Server only, never sent to the browser. Without it a built-in guide answers
# from the same live map data (places from OpenStreetMap, walks on real paths).
ANTHROPIC_API_KEY=

# Optional: Reddit reviews for places the guide pins. Reddit blocks anonymous and
# crawler access, so this uses Reddit's official API. Create a free "script" app at
# https://www.reddit.com/prefs/apps and paste its id and secret. Without them the
# guide finds reviews on the open web instead (review sites, blogs), with links.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Shared map pins, audio signaling and encrypted rooms across server instances.
# Set REDIS_URL (Redis TCP), or KV_REST_API_URL and KV_REST_API_TOKEN (Upstash).
REDIS_URL=
# Stable cookie signature for private room ownership. Defaults to NEXCONN_APP_SECRET.
IDENTITY_SECRET=
# Optional coturn-compatible relay for calls across restrictive networks.
# Comma-separated turn:/turns: URLs. The shared secret stays server-side.
TURN_URLS=
TURN_SHARED_SECRET=
