 ids=re.findall(r' id=\"(["'^"]+)"'"',s)
 mock=\"\"\"const elements={};function stub(){return {style:{},classList:{toggle(){}},append(){},replaceChildren(){},addEventListener(){},setCustomValidity(){},reportValidity(){},querySelector(){return stub()},focus(){},scrollIntoView(){}}}
 const document={getElementById:id=>elements[id],querySelectorAll:()=>[],createElement:stub,head:{append(){}}};const location={search:'',href:''};
 \"\"\"
 mock+='for(const k of '+json.dumps(ids)+')elements[k]=stub();\\n'
 checks={'desktop':\"pick(3);if(el('enter').href"'!=='"'chat.html?area=3')throw Error();pick(2);if(location.href"'!=='"'build.html')throw Error();\",'map':\"pick(0);if(el('event').style.display"'!=='"'none')throw Error();pick(1);if(el('active').textContent"'!=='"'24 active')throw Error();\",'build':\"el('name').value='Garden Club';el('create').onclick();if("'!location.href.endsWith('"'name=Garden%20Club'))throw Error();\",'chat':\"if(el('room').textContent"'!=='"'Indiranagar')throw Error();\"}
