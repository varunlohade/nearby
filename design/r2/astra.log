import math,json,base64,urllib.request,concurrent.futures,time
lat,lon=12.970,77.619
n=8192
cx=int((lon+180)/360*n);cy=int((1-math.asinh(math.tan(math.radians(lat)))/math.pi)/2*n)
for d,style in [('A','rastertiles/voyager_nolabels'),('B','dark_nolabels')]:
 def tile(p):
  x,y=p
  for i in range(3):
   try:
    b=urllib.request.urlopen(f'https://basemaps.cartocdn.com/{style}/13/{x}/{y}.png',timeout=18).read()
    if not b.startswith(b'\\x89PNG'):raise ValueError()
    return [x,y,base64.b64encode(b).decode()]
   except Exception:
    if i==2:return [x,y,'']
 with concurrent.futures.ThreadPoolExecutor(16) as e: rows=list(e.map(tile,[(x,y) for x in range(cx-6,cx+7) for y in range(cy-4,cy+5)]))
 print(d,len(rows),sum(len(r[2]) for r in rows),flush=True)
 json.dump(rows,open('.work/'+d+'.json','w'))
