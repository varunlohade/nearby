import sys
sys.path.insert(0,'.work/lib')
import json,urllib.request,concurrent.futures,gzip,io,base64,time,collections
import mapbox_vector_tile
from PIL import Image,ImageDraw
tiles=json.load(open('.work/A.json'))
url=json.load(urllib.request.urlopen('https://tiles.openfreemap.org/planet'))['tiles'][0]
def get(t):
 x,y,_=t
 for i in range(4):
  try:
   b=urllib.request.urlopen(url.format(z=13,x=x,y=y),timeout=12).read()
   if b[:2]==b'\\x1f\\x8b':b=gzip.decompress(b)
   data=mapbox_vector_tile.decode(b,default_options={'y_coord_down':True});break
  except Exception as e:
   if i==3:raise
 out=[]
 for d in 'AB':
  dark=d=='B'
  def col(a,b):return b if dark else a
  im=Image.new('RGB',(512,512),col('#eae8dc','#202b29'));p=ImageDraw.Draw(im)
  def draw(layer,select,mode,color,width=1):
   for f in data.get(layer,{}).get('features',[]):
    if not select(f['properties']):continue
    g=f['geometry'];polys=g['coordinates']
    if g['type']=='Polygon':lines=polys[:1]
    elif g['type']=='MultiPolygon':lines=[item[0] for item in polys]
    elif g['type']=='LineString':lines=[polys]
    elif g['type']=='MultiLineString':lines=polys
    else:continue
    for line in lines:
     pts=[(v[0]/8,v[1]/8) for v in line]
     if len(pts)<(3 if mode=='fill' else 2):continue
     if mode=='fill':p.polygon(pts,fill=color)
     else:p.line(pts,fill=color,width=width,joint='curve')
  allf=lambda f:True
  draw('landuse',allf,'fill',col('#e4e1d3','#26302e'))
  for l in ['landcover','park']:draw(l,allf,'fill',col('#c3d2ad','#31453a'))
  draw('landuse',lambda f:f.get('class') in ['park','grass','cemetery','recreation_ground','village_green'],'fill',col('#c4d4b1','#33493b'))
  draw('water',allf,'fill',col('#adcfd0','#23424a'))
  draw('waterway',allf,'line',col('#a5caca','#2b5058'),3)
  draw('building',allf,'fill',col('#dbd8ca','#2d3732'))
  for classes,w,c in [('path track service',1,col('#faf8ed','#424c47')),('minor residential unclassified',2,col('#fffdf4','#49534c')),('tertiary secondary',5,col('#d2c6aa','#58635a')),('tertiary secondary',3,col('#fffbee','#738075')),('primary trunk motorway',9,col('#d5c49f','#637064')),('primary trunk motorway',6,col('#ffedc9','#919d86')),('rail',2,col('#afafa1','#535f55'))]:
   draw('transportation',lambda f:f.get('class') in classes.split(),'line',c,w)
  buf=io.BytesIO();im.resize((256,256),Image.Resampling.LANCZOS).save(buf,format='WEBP',quality=83);out.append([x,y,base64.b64encode(buf.getvalue()).decode()])
 return out
with concurrent.futures.ThreadPoolExecutor(12) as ex:r=list(ex.map(get,tiles))
for i,d in enumerate('AB'):json.dump([pair[i] for pair in r],open('.work/'+d+'.json','w'))
