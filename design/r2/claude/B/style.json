   }
  },
  {
   "id": "green",
   "type": "fill",
   "source": "omt",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "grass",
     "wood"
    ],
    true,
    false
   ],
